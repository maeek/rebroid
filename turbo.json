{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "EXTERNAL_ADB_BROKER_URL",
        "EXTERNAL_ADB_BROKER_SECRET",
        "EXTERNAL_ADB_TCP_ENDPOINTS",
        "EXTERNAL_ADB_DEV_UDP_PORT",
        "EXTERNAL_ADB_KEYS_DIRECTORY"
      ]
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
