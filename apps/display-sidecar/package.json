{
  "name": "@rebroid/display-sidecar",
  "version": "0.1.0",
  "description": "NestJS sidecar for Rebroid display sessions, ADB actions, and browser preview streaming.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/clean-viewer-assets.mjs && tsc -p src/modules/display/viewer/tsconfig.json && node scripts/rewrite-viewer-imports.mjs && node scripts/copy-assets.mjs",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/modules/display/viewer/tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@fastify/helmet": "^13.0.2",
    "@nestjs/common": "^11.1.24",
    "@rebroid/application-core": "workspace:*",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-fastify": "^11.1.24",
    "@nestjs/platform-ws": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/websockets": "^11.1.24",
    "fastify": "^5.8.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
