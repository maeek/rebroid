{
  "name": "@rebroid/display-sidecar",
  "version": "0.1.0",
  "description": "NestJS sidecar for Rebroid display sessions, ADB actions, and browser preview streaming.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-viewer.mjs",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "pnpm build && node --test \"dist/**/*.spec.js\" scripts/display-media-worker.test.mjs scripts/display-media-worker-mse.test.mjs scripts/display-audio-worklet.test.mjs scripts/fragmented-mp4.test.mjs scripts/mse-video-player.test.mjs scripts/webrtc-adaptive-jitter.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/modules/display/viewer/tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@fastify/helmet": "^13.0.2",
    "@nestjs/common": "^11.1.24",
    "@rebroid/android-application-core": "workspace:*",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-fastify": "^11.1.24",
    "@nestjs/platform-ws": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/websockets": "^11.1.24",
    "fastify": "^5.8.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:"
  }
}
