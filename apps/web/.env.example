ORCHESTRATOR_API_URL=http://localhost:4100
ORCHESTRATOR_SHARED_SECRET=
DISPLAY_SIDECAR_INTERNAL_BASE_URL=http://localhost:8000
# Match the broker secret in apps/orchestrator/.env when developing external devices.
# EXTERNAL_ADB_BROKER_SECRET=
NEXTAUTH_SECRET=
MFA_ENCRYPTION_KEY=
INITIAL_ADMIN_PASSWORD=
AUTH_TRUST_HOST=false
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
DEV_HOST=127.0.0.1
# For LAN HTTPS, use a certificate that covers the laptop's LAN IP.
# DEV_HTTPS_KEY=certificates/rebroid-lan-key.pem
# DEV_HTTPS_CERT=certificates/rebroid-lan.pem

# Leave NEXTAUTH_URL unset for host-agnostic local and LAN login.
# NEXTAUTH_URL=
