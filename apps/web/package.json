    "@rebroid/firewall-policy-core": "workspace:*",
    "@rebroid/orchestrator-contracts": "workspace:*",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/bcrypt": "^6.0.0",
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "monaco-editor": "^0.57.0",
    "monaco-yaml": "^5.5.1",
    "next": "^16.4.3",
