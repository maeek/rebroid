{
  "name": "rebroid-firewall-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "format:check": "prettier --check \"src/**/*.ts\"",
