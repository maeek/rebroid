# Optional local-development overrides.
# The Docker image generates ORCHESTRATOR_SHARED_SECRET automatically when it is not provided.

NODE_ENV=development
PORT=4100
ORCHESTRATOR_SHARED_SECRET=change-me
DOCKER_SOCKET_PATH=/var/run/docker.sock
DATABASE_PATH=./data/orchestrator.sqlite
SETTINGS_PATH=./data/orchestrator-settings.json
UPLOADS_DIR=./data/uploads
RUNTIME_LOGS_DIR=./data/runtime-logs

# Local dev can run a standalone display sidecar instead of autostarting a
# managed sidecar container.
DISPLAY_SIDECAR_INTERNAL_BASE_URL=http://localhost:8000
DISPLAY_SIDECAR_AUTO_START=false

# Runtime defaults exposed in the UI settings.
CONTAINER_IMAGE=redroid/redroid:13.0.0-latest
REDROID_ADB_PORT=5555
DEFAULT_INACTIVITY_TIMEOUT_SECONDS=900
MAX_APK_UPLOAD_SIZE_MB=512
DOCKER_MAX_CONCURRENT_READS=8

# Advanced network policy tuning.
FIREWALL_AGENT_SOCKET=/tmp/rebroid-firewall/agent.sock
FIREWALL_AGENT_SHARED_SECRET=change-me
FIREWALL_POLICY_BOOTSTRAP=false
NETWORK_POLICY_DEFAULT_ALLOW_DESTINATIONS=API_IP,GATEWAY_IP
NETWORK_POLICY_API_HOST=
NETWORK_POLICY_API_CIDRS=
