{
  "workspaces": {
    "apps/web": {
      "entry": ["src/app/**/*.{ts,tsx}", "rebroid-proxy-server.mjs"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/orchestrator": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/display-sidecar": {
      "entry": ["src/main.ts", "src/modules/display/viewer/src/app.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/firewall-agent": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
