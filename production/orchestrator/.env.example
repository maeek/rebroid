# Optional local-development overrides.
# The Docker image generates ORCHESTRATOR_SHARED_SECRET automatically when it is not provided.

NODE_ENV=development
PORT=4100
ORCHESTRATOR_SHARED_SECRET=change-me
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Runtime defaults exposed in the UI settings.
CONTAINER_IMAGE=redroid/redroid:13.0.0-latest
DEFAULT_INACTIVITY_TIMEOUT_SECONDS=900
MAX_APK_UPLOAD_SIZE_MB=4096

# Advanced network policy tuning.
IPTABLES_POLICY_ENABLED=false
NETWORK_POLICY_DEFAULT_ALLOW_DESTINATIONS=API_IP,GATEWAY_IP
NETWORK_POLICY_API_HOST=
NETWORK_POLICY_API_CIDRS=
