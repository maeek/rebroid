NODE_ENV=development
PORT=4100
ORCHESTRATOR_SHARED_SECRET=change-me
DATABASE_PATH=./data/orchestrator.sqlite
SETTINGS_PATH=./data/orchestrator-settings.json
UPLOADS_DIR=./uploads

# Docker socket is expected to be mounted into the orchestrator container.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Set this when the orchestrator itself runs as a container and must be attached
# to each per-app internal Docker network.
ORCHESTRATOR_CONTAINER_ID=

CONTAINER_IMAGE=redroid/redroid:13.0.0-latest
REDROID_DATA_MOUNT_PATH=/data
REDROID_ADB_PORT=5555
REDROID_PRIVILEGED=true
DEFAULT_INACTIVITY_TIMEOUT_SECONDS=900
MAX_APK_UPLOAD_SIZE_MB=512
WS_SCRCPY_IMAGE=shop-me-alone/ws-scrcpy-sidecar:latest
# Local Docker build context used when the sidecar image is missing.
WS_SCRCPY_BUILD_CONTEXT=../ws-scrcpy-sidecar
WS_SCRCPY_CONTAINER_NAME=sma-ws-scrcpy
# Optional override for an externally managed sidecar. Usually leave empty and let the orchestrator create it.
WS_SCRCPY_CONTAINER_ID=
WS_SCRCPY_AUTO_START=true
# Optional Docker network used so Next.js can reach the spawned sidecar by name.
WS_SCRCPY_PLATFORM_NETWORK=
WS_SCRCPY_PORT=8000
WS_SCRCPY_PLAYER=mse
# Optional override for ws-scrcpy's proxy-adb remote query. Defaults to tcp:<ADB port>.
WS_SCRCPY_PROXY_REMOTE=
DOCKER_RESOURCE_PREFIX=sma
IPTABLES_POLICY_ENABLED=false
IPTABLES_BINARY=iptables
# Hidden, backend-owned egress destinations applied to every app policy.
# Supported tokens: API_IP, ORCHESTRATOR_IP, GATEWAY_IP, DEFAULT, or explicit IPv4/CIDR.
# The ws-scrcpy sidecar IP is resolved and added internally when it is attached to an app network.
NETWORK_POLICY_DEFAULT_ALLOW_DESTINATIONS=API_IP,GATEWAY_IP
# Optional explicit API host or CIDRs for API_IP when the API is not attached to the app network.
NETWORK_POLICY_API_HOST=
NETWORK_POLICY_API_CIDRS=
VOLUME_USAGE_CACHE_TTL_SECONDS=300
