NODE_ENV=development
PORT=4100
DATABASE_PATH=./data/orchestrator.sqlite
UPLOADS_DIR=./uploads

# Docker socket is expected to be mounted into the orchestrator container.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Set this when the orchestrator itself runs as a container and must be attached
# to each per-app internal Docker network.
ORCHESTRATOR_CONTAINER_ID=

REDROID_IMAGE=redroid/redroid:13.0.0-latest
REDROID_DATA_MOUNT_PATH=/data
REDROID_ADB_PORT=5555
REDROID_PRIVILEGED=true
DEFAULT_INACTIVITY_TIMEOUT_SECONDS=900
DOCKER_RESOURCE_PREFIX=sma
