{
  "name": "@rebroid/application-core",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    "./redroid-runtime": {
      "types": "./dist/redroid-runtime.d.ts",
      "default": "./dist/redroid-runtime.js"
    },
    "./container-image": {
      "types": "./dist/container-image.d.ts",
      "default": "./dist/container-image.js"
    },
    "./command-line": {
      "types": "./dist/command-line.d.ts",
      "default": "./dist/command-line.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test \"dist/**/*.spec.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
