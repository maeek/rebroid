{
  "name": "@rebroid/automation-core",
  "version": "0.1.0",
  "description": "Framework-neutral automation definitions and metadata shared by Rebroid applications.",
  "private": true,
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    "./definition": {
      "types": "./dist/definition.d.ts",
      "default": "./dist/definition.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./command-registry": {
      "types": "./dist/command-registry.d.ts",
      "default": "./dist/command-registry.js"
    },
    "./ai-public-text": {
      "types": "./dist/ai-public-text.d.ts",
      "default": "./dist/ai-public-text.js"
    },
    "./yaml-draft": {
      "types": "./dist/yaml-draft.d.ts",
      "default": "./dist/yaml-draft.js"
    }
  },
  "typesVersions": {
    "*": {
      "definition": [
        "dist/definition.d.ts"
      ],
      "metadata": [
        "dist/metadata.d.ts"
      ],
      "command-registry": [
        "dist/command-registry.d.ts"
      ],
      "ai-public-text": [
        "dist/ai-public-text.d.ts"
      ],
      "yaml-draft": [
        "dist/yaml-draft.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test \"dist/**/*.spec.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
