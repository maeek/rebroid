{
  "name": "@rebroid/android-application-core",
  "version": "0.1.0",
  "description": "Shared Redroid runtime and viewer-control contracts used by Rebroid applications.",
  "private": true,
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    "./redroid-runtime": {
      "types": "./dist/redroid-runtime.d.ts",
      "default": "./dist/redroid-runtime.js"
    },
    "./viewer-control": {
      "types": "./dist/viewer-control.d.ts",
      "default": "./dist/viewer-control.js"
    }
  },
  "typesVersions": {
    "*": {
      "redroid-runtime": [
        "dist/redroid-runtime.d.ts"
      ],
      "viewer-control": [
        "dist/viewer-control.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test \"dist/**/*.spec.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
