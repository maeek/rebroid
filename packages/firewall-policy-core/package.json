{
  "name": "@rebroid/firewall-policy-core",
  "version": "0.1.0",
  "description": "Pure firewall policy contracts and validation shared by Rebroid runtimes.",
  "private": true,
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    "./policy": {
      "types": "./dist/policy.d.ts",
      "default": "./dist/policy.js"
    }
  },
  "typesVersions": {
    "*": {
      "policy": [
        "dist/policy.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test \"dist/**/*.spec.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
